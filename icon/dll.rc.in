IDI_ICON1 ICON "small.ico"
IDI_ICON2 ICON "big.ico"

IDI_ICON3 ICON "mini.ico"
IDI_ICON4 ICON "juststudio.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @JUSTC_VERSION_MAJOR@,@JUSTC_VERSION_MINOR@,@JUSTC_VERSION_PATCH@,@JUSTC_VERSION_BUILD@
PRODUCTVERSION  @JUSTC_VERSION_MAJOR@,@JUSTC_VERSION_MINOR@,@JUSTC_VERSION_PATCH@,@JUSTC_VERSION_BUILD@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "JustStudio.\0"
            VALUE "FileDescription", "The JUSTC Programming Language\0"
            VALUE "FileVersion", "@JUSTC_VERSION_MAJOR@.@JUSTC_VERSION_MINOR@.@JUSTC_VERSION_PATCH@.@JUSTC_VERSION_BUILD@\0"
            VALUE "InternalName", "justc\0"
            VALUE "LegalCopyright", "Copyright (c) 2025-2026 JustStudio. All rights reserved.\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "justc.dll\0"
            VALUE "ProductName", "JUSTC\0"
            VALUE "ProductVersion", "@JUSTC_VERSION_MAJOR@.@JUSTC_VERSION_MINOR@.@JUSTC_VERSION_PATCH@.@JUSTC_VERSION_BUILD@\0"
            VALUE "Comments", "JUSTC DLL\0"
            VALUE "PrivateBuild", "\0"
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
